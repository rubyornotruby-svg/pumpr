{
  "name": "pumpr",
  "main": "src/worker.js",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page",
    "run_worker_first": ["/desk", "/desk/*", "/api/*"]
  },
  "kv_namespaces": [
    { "binding": "CODES" }
  ]
}
